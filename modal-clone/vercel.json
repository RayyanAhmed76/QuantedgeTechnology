{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_RAILWAY_URL/api/:path*"
    },
    {
      "source": "/consultancy",
      "destination": "https://REPLACE_WITH_CONSULTANCY_VERCEL_URL/consultancy"
    },
    {
      "source": "/consultancy/:path*",
      "destination": "https://REPLACE_WITH_CONSULTANCY_VERCEL_URL/consultancy/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
